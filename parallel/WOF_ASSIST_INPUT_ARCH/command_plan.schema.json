{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wof.local/schemas/assist-command-plan-v1.json",
  "title": "WOF Assist Symbolic Command Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "planId", "deadlineMs", "steps"],
  "properties": {
    "schema": {"const": "wof-assist-command-plan-v1"},
    "planId": {"type": "string", "minLength": 1},
    "deadlineMs": {"type": "integer", "minimum": 1},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
  },
  "$defs": {
    "symbol": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s].*[^\\s]$|^[^\\s]$"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "symbol", "timeoutMs"],
      "properties": {
        "op": {"enum": ["press", "release", "hold"]},
        "symbol": {"$ref": "#/$defs/symbol"},
        "holdMs": {"type": "integer", "minimum": 0},
        "timeoutMs": {"type": "integer", "minimum": 1},
        "preconditions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": []
        },
        "ack": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"op": {"const": "hold"}}, "required": ["op"]},
          "then": {"required": ["holdMs"], "properties": {"holdMs": {"minimum": 1}}},
          "else": {"properties": {"holdMs": {"const": 0}}}
        }
      ]
    }
  }
}
