{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wof-training-farm-observation-plan-v1",
  "title": "WOF Training Farm R0.3 Observation Discovery Plan",
  "type": "object",
  "required": [
    "schema",
    "experimentId",
    "startingSavestateId",
    "expectedStartStateSha256",
    "baselineActions",
    "interventions",
    "horizonFrames",
    "repetitions",
    "captureFrames",
    "metadata"
  ],
  "properties": {
    "schema": {"const": "wof-training-farm-observation-plan-v1"},
    "experimentId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "startingSavestateId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "expectedStartStateSha256": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "baselineActions": {"$ref": "#/$defs/actionSequence"},
    "interventions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["interventionId", "actions"],
        "properties": {
          "interventionId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "actions": {"$ref": "#/$defs/actionSequence"}
        },
        "additionalProperties": false
      }
    },
    "horizonFrames": {"type": "integer", "minimum": 1, "maximum": 100000},
    "repetitions": {"type": "integer", "minimum": 2, "maximum": 100},
    "captureFrames": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 100000}
    },
    "metadata": {
      "type": "object",
      "required": ["semanticLabel", "hypothesis"],
      "properties": {
        "semanticLabel": {"type": ["string", "null"], "maxLength": 1024},
        "hypothesis": {"type": ["string", "null"], "maxLength": 1024}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "actionSequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["frames", "inputs"],
        "properties": {
          "frames": {"type": "integer", "minimum": 1, "maximum": 100000},
          "inputs": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["player", "pressed"],
              "properties": {
                "player": {"type": "integer", "minimum": 0, "maximum": 3},
                "pressed": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "integer", "minimum": 0, "maximum": 4095}
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
