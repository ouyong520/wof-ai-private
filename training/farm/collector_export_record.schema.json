            "layoutIdentitySha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "schema": {"const": "wof-training-farm-fork-memory-layout-v1"},
            "sourceNamespace": {"const": "stable-retro-fbneo"}
