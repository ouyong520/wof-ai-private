    "branchId": {"anyOf": [{"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "type": "string"}, {"type": "null"}]},
    "captureBindingSha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "completeness": {"enum": ["COMPLETE", "PARTIAL"]},
    "episodeGeneration": {"anyOf": [{"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "type": "string"}, {"type": "null"}]},
    "episodeId": {"anyOf": [{"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "type": "string"}, {"type": "null"}]},
    "evidenceKinds": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "exporterSourceIdentitySha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "exporterVersion": {"const": "wof-training-farm-read-only-exporter-v1"},
