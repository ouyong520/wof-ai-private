    "generationStartedUnixMs": {"maximum": 9223372036854775807, "minimum": 0, "type": "integer"},
    "health": {"enum": ["ACTIVE", "DEGRADED", "STOPPED"]},
    "logicalFrame": {"anyOf": [{"maximum": 9223372036854775807, "minimum": 0, "type": "integer"}, {"type": "null"}]},
    "memoryLayoutIdentitySha256": {"anyOf": [{"pattern": "^[0-9a-f]{64}$", "type": "string"}, {"type": "null"}]},
    "monotonicSequence": {"maximum": 9223372036854775807, "minimum": 1, "type": "integer"},
    "previousRecordIdentitySha256": {"anyOf": [{"pattern": "^[0-9a-f]{64}$", "type": "string"}, {"type": "null"}]},
    "processId": {"maximum": 9223372036854775807, "minimum": 1, "type": "integer"},
    "publishedAtUnixMs": {"maximum": 9223372036854775807, "minimum": 0, "type": "integer"},
    "recordIdentitySha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "romSha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "rootId": {"anyOf": [{"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "type": "string"}, {"type": "null"}]},
    "runtimeIdentitySha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "safety": {"$ref": "#/$defs/safety"},
    "schema": {"const": "wof-training-farm-collector-export-record-v1"},
    "sourceNamespace": {"const": "stable-retro-fbneo"},
    "stepCounter": {"anyOf": [{"maximum": 9223372036854775807, "minimum": 0, "type": "integer"}, {"type": "null"}]},
    "workerGeneration": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "type": "string"},
    "workerId": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "type": "string"}
