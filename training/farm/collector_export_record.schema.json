{
  "$defs": {
    "safety": {
      "additionalProperties": false,
      "properties": {
        "inputInjection": {"const": false},
        "readOnlyExporter": {"const": true},
        "trainingControlAuthority": {"const": false},
        "workerLaunchAuthority": {"const": false},
        "workerSchedulingAuthority": {"const": false},
        "writesGameMemory": {"const": false}
