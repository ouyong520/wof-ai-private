    "resume": {"type":"object","additionalProperties":false,"required":["requested","acceptedBranchIds","sourceResultSha256"],"properties":{"requested":{"type":"boolean"},"acceptedBranchIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"sourceResultSha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha"}]}}},
