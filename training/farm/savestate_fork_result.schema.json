    "spec": {"type":"object","additionalProperties":false,"required":["branchId","horizonFrames","actions","actionSequenceSha256","branchIdentitySha256","metadata"],"properties":{"branchId":{"$ref":"#/$defs/id"},"horizonFrames":{"type":"integer","minimum":1,"maximum":100000},"actions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/action"}},"actionSequenceSha256":{"$ref":"#/$defs/sha"},"branchIdentitySha256":{"$ref":"#/$defs/sha"},"metadata":{"type":"object","additionalProperties":false,"required":["label"],"properties":{"label":{"oneOf":[{"type":"null"},{"type":"string","maxLength":256}]}}}}},
    "layout": {"type":"object","additionalProperties":false,"required":["schema","sourceNamespace","addressKind","blocks","layoutIdentitySha256"],"properties":{"schema":{"const":"wof-training-farm-fork-memory-layout-v1"},"sourceNamespace":{"const":"stable-retro-fbneo"},"addressKind":{"const":"stable-retro-memory-block-key-plus-byte-offset"},"blocks":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["index","baseAddress","length"],"properties":{"index":{"type":"integer","minimum":0},"baseAddress":{"type":"integer","minimum":0},"length":{"type":"integer","minimum":1}}}},"layoutIdentitySha256":{"$ref":"#/$defs/sha"}}},
    "root": {"type":"object","additionalProperties":false,"required":["schema","sourceNamespace","forkSetId","rootId","rootCaptureMode","rootLogicalFrame","rootSavestateSha256","rootRamSha256","rootRamBlocksSha256","memoryLayoutIdentity","runtimeIdentity","runtimeIdentitySha256","stableRuntimeAuthority","romSha256","farmCandidateSha256","forkCandidateSha256","forkSourceFiles","inputIsolationMode","rootAuthoritySha256"],"properties":{"schema":{"const":"wof-training-farm-fork-root-authority-v1"},"sourceNamespace":{"const":"stable-retro-fbneo"},"forkSetId":{"$ref":"#/$defs/id"},"rootId":{"$ref":"#/$defs/id"},"rootCaptureMode":{"enum":["RESET_CAPTURE","EXTERNAL_LOCAL_STATE"]},"rootLogicalFrame":{"const":0},"rootSavestateSha256":{"$ref":"#/$defs/sha"},"rootRamSha256":{"$ref":"#/$defs/sha"},"rootRamBlocksSha256":{"$ref":"#/$defs/sha"},"memoryLayoutIdentity":{"$ref":"#/$defs/layout"},"runtimeIdentity":{"type":"object"},"runtimeIdentitySha256":{"$ref":"#/$defs/sha"},"stableRuntimeAuthority":{"type":"object"},"romSha256":{"$ref":"#/$defs/sha"},"farmCandidateSha256":{"$ref":"#/$defs/sha"},"forkCandidateSha256":{"$ref":"#/$defs/sha"},"forkSourceFiles":{"type":"object","minProperties":1,"additionalProperties":{"$ref":"#/$defs/sha"}},"inputIsolationMode":{"const":"explicit-all-player-mask-every-frame"},"rootAuthoritySha256":{"$ref":"#/$defs/sha"}}},
    "checkpoint": {"type":"object","additionalProperties":false,"required":["frame","actionStep","ramSha256"],"properties":{"frame":{"type":"integer","minimum":1,"maximum":100000},"actionStep":{"type":"integer","minimum":0},"ramSha256":{"$ref":"#/$defs/sha"}}},
    "outcome": {"type":"object","additionalProperties":false,"required":["repetitionIndex","branchId","branchIdentitySha256","actionSequenceSha256","horizonFrames","framesExecuted","rootSavestateSha256","restoredRamSha256","restoredRamBlocksSha256","roundtripRootSavestateSha256","finalRamSha256","finalRamBlocksSha256","finalSavestateSha256","memoryLayoutIdentitySha256","checkpoints","outcomeFingerprintSha256"],"properties":{"repetitionIndex":{"type":"integer","minimum":0,"maximum":9},"branchId":{"$ref":"#/$defs/id"},"branchIdentitySha256":{"$ref":"#/$defs/sha"},"actionSequenceSha256":{"$ref":"#/$defs/sha"},"horizonFrames":{"type":"integer","minimum":1,"maximum":100000},"framesExecuted":{"type":"integer","minimum":1,"maximum":100000},"rootSavestateSha256":{"$ref":"#/$defs/sha"},"restoredRamSha256":{"$ref":"#/$defs/sha"},"restoredRamBlocksSha256":{"$ref":"#/$defs/sha"},"roundtripRootSavestateSha256":{"$ref":"#/$defs/sha"},"finalRamSha256":{"$ref":"#/$defs/sha"},"finalRamBlocksSha256":{"$ref":"#/$defs/sha"},"finalSavestateSha256":{"$ref":"#/$defs/sha"},"memoryLayoutIdentitySha256":{"$ref":"#/$defs/sha"},"checkpoints":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/checkpoint"}},"outcomeFingerprintSha256":{"$ref":"#/$defs/sha"}}},
    "branch": {"type":"object","additionalProperties":false,"required":["branchId","branchIdentitySha256","actionSequenceSha256","horizonFrames","status","reasonCode","message","repetitionsRequired","repetitionsCompleted","deterministic","firstDivergence","reusedFromResume","outcomes"],"properties":{"branchId":{"$ref":"#/$defs/id"},"branchIdentitySha256":{"$ref":"#/$defs/sha"},"actionSequenceSha256":{"$ref":"#/$defs/sha"},"horizonFrames":{"type":"integer","minimum":1,"maximum":100000},"status":{"enum":["PASS","FAIL","ERROR"]},"reasonCode":{"type":"string","minLength":1},"message":{"type":"string"},"repetitionsRequired":{"type":"integer","minimum":2,"maximum":10},"repetitionsCompleted":{"type":"integer","minimum":0,"maximum":10},"deterministic":{"type":"boolean"},"firstDivergence":{"oneOf":[{"type":"null"},{"type":"object"}]},"reusedFromResume":{"type":"boolean"},"outcomes":{"type":"array","maxItems":10,"items":{"$ref":"#/$defs/outcome"}}}}
