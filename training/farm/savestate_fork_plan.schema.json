{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wof-training-farm-savestate-fork-plan-v1",
  "title": "WOF Training Farm R0.4 deterministic savestate fork plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "forkSetId", "root", "repetitions", "branches"],
  "properties": {
    "schema": {"const": "wof-training-farm-savestate-fork-plan-v1"},
    "forkSetId": {"$ref": "#/$defs/id"},
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootId", "expectedSavestateSha256"],
      "properties": {
        "rootId": {"$ref": "#/$defs/id"},
        "expectedSavestateSha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        }
      }
    },
    "repetitions": {"type": "integer", "minimum": 2, "maximum": 10},
    "branches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/branch"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pressed": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 4095}
    },
    "playerInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player", "pressed"],
      "properties": {
        "player": {"type": "integer", "minimum": 0, "maximum": 3},
        "pressed": {"$ref": "#/$defs/pressed"}
      }
    },
    "frameInputs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/playerInput"}, {"properties": {"player": {"const": 0}}}]},
        {"allOf": [{"$ref": "#/$defs/playerInput"}, {"properties": {"player": {"const": 1}}}]},
        {"allOf": [{"$ref": "#/$defs/playerInput"}, {"properties": {"player": {"const": 2}}}]},
        {"allOf": [{"$ref": "#/$defs/playerInput"}, {"properties": {"player": {"const": 3}}}]}
      ],
      "items": false
    },
    "actionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames", "inputs"],
      "properties": {
        "frames": {"type": "integer", "minimum": 1, "maximum": 100000},
        "inputs": {"$ref": "#/$defs/frameInputs"}
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branchId", "horizonFrames", "actions", "metadata"],
      "properties": {
        "branchId": {"$ref": "#/$defs/id"},
        "horizonFrames": {"type": "integer", "minimum": 1, "maximum": 100000},
        "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/actionStep"}},
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label"],
          "properties": {"label": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 256}]}}
        }
      }
    }
  }
}
