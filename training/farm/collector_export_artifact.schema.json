    "exporterSourceIdentitySha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "exporterVersion": {"const": "wof-training-farm-read-only-exporter-v1"},
    "farmCandidateSha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "forkSetId": {"anyOf": [{"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "type": "string"}, {"type": "null"}]},
    "generationStartedUnixMs": {"maximum": 9223372036854775807, "minimum": 0, "type": "integer"},
    "health": {"enum": ["ACTIVE", "DEGRADED", "STOPPED"]},
    "logicalFrame": {"anyOf": [{"maximum": 9223372036854775807, "minimum": 0, "type": "integer"}, {"type": "null"}]},
    "memoryLayoutIdentity": {"anyOf": [{"$ref": "#/$defs/memoryLayout"}, {"type": "null"}]},
    "monotonicSequence": {"maximum": 9223372036854775807, "minimum": 1, "type": "integer"},
    "observationStream": {"items": {"$ref": "#/$defs/sample"}, "maxItems": 4096, "type": "array"},
    "processId": {"maximum": 9223372036854775807, "minimum": 1, "type": "integer"},
    "publishedAtUnixMs": {"maximum": 9223372036854775807, "minimum": 0, "type": "integer"},
    "ramBlocksSnapshot": {"anyOf": [{"$ref": "#/$defs/blockSnapshot"}, {"type": "null"}]},
    "ramSnapshot": {"anyOf": [{"$ref": "#/$defs/bytes"}, {"type": "null"}]},
    "rawBytes": {"maximum": 16777216, "minimum": 0, "type": "integer"},
    "romSha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "rootForkBranchSavestateMetadata": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "rootId": {"anyOf": [{"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "type": "string"}, {"type": "null"}]},
    "runtimeIdentity": {"type": "object"},
    "runtimeIdentitySha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "runtimeResourceTimingMetadata": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "safety": {"$ref": "#/$defs/safety"},
    "schema": {"const": "wof-training-farm-collector-export-artifact-v1"},
    "sourceNamespace": {"const": "stable-retro-fbneo"},
    "stepCounter": {"anyOf": [{"maximum": 9223372036854775807, "minimum": 0, "type": "integer"}, {"type": "null"}]},
    "trajectoryMetadata": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "workerGeneration": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "type": "string"},
    "workerId": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "type": "string"}
  },
  "required": ["schema", "sourceNamespace", "exporterVersion", "exporterSourceIdentitySha256", "exporterSourceFiles", "workerId", "workerGeneration", "generationStartedUnixMs", "processId", "monotonicSequence", "publishedAtUnixMs", "logicalFrame", "stepCounter", "episodeId", "episodeGeneration", "forkSetId", "rootId", "branchId", "runtimeIdentity", "runtimeIdentitySha256", "romSha256", "farmCandidateSha256", "memoryLayoutIdentity", "captureBindingSha256", "active", "health", "completeness", "evidenceKinds", "rawBytes", "ramSnapshot", "ramBlocksSnapshot", "observationStream", "trajectoryMetadata", "actionResultTrajectory", "rootForkBranchSavestateMetadata", "runtimeResourceTimingMetadata", "currentActionResultMetadata", "safety"],
  "title": "WOF Training Farm Collector Export Immutable Artifact v1",
  "type": "object"
}
