{
  "$defs": {
    "blockSnapshot": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "baseAddress": {"minimum": 0, "type": "integer"},
              "data": {"minLength": 1, "type": "string"},
              "encoding": {"const": "base64"},
              "index": {"minimum": 0, "type": "integer"},
              "length": {"minimum": 1, "type": "integer"},
              "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
            },
            "required": ["index", "baseAddress", "length", "sha256", "encoding", "data"],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "memoryLayoutIdentity": {"$ref": "#/$defs/memoryLayout"}
      },
      "required": ["memoryLayoutIdentity", "blocks"],
      "type": "object"
    },
    "bytes": {
      "additionalProperties": false,
      "properties": {
        "bytes": {"minimum": 1, "type": "integer"},
        "data": {"minLength": 1, "type": "string"},
        "encoding": {"const": "base64"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["encoding", "bytes", "sha256", "data"],
      "type": "object"
    },
    "memoryLayout": {
      "additionalProperties": false,
      "properties": {
        "addressKind": {"const": "stable-retro-memory-block-key-plus-byte-offset"},
        "blocks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "baseAddress": {"minimum": 0, "type": "integer"},
              "index": {"minimum": 0, "type": "integer"},
              "length": {"minimum": 1, "type": "integer"}
            },
            "required": ["index", "baseAddress", "length"],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "layoutIdentitySha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "schema": {"const": "wof-training-farm-fork-memory-layout-v1"},
        "sourceNamespace": {"const": "stable-retro-fbneo"}
      },
      "required": ["schema", "sourceNamespace", "addressKind", "blocks", "layoutIdentitySha256"],
      "type": "object"
    },
    "safety": {
      "additionalProperties": false,
      "properties": {
        "inputInjection": {"const": false},
        "readOnlyExporter": {"const": true},
        "trainingControlAuthority": {"const": false},
        "workerLaunchAuthority": {"const": false},
        "workerSchedulingAuthority": {"const": false},
        "writesGameMemory": {"const": false}
      },
      "required": ["readOnlyExporter", "writesGameMemory", "inputInjection", "trainingControlAuthority", "workerLaunchAuthority", "workerSchedulingAuthority"],
      "type": "object"
    },
    "sample": {
      "additionalProperties": false,
      "properties": {
        "logicalFrame": {"anyOf": [{"maximum": 9223372036854775807, "minimum": 0, "type": "integer"}, {"type": "null"}]},
        "metadata": {"anyOf": [{"type": "object"}, {"type": "null"}]},
        "ram": {"anyOf": [{"$ref": "#/$defs/bytes"}, {"type": "null"}]},
        "ramBlocks": {"anyOf": [{"$ref": "#/$defs/blockSnapshot"}, {"type": "null"}]},
        "sampleSequence": {"minimum": 1, "type": "integer"},
        "stepCounter": {"anyOf": [{"maximum": 9223372036854775807, "minimum": 0, "type": "integer"}, {"type": "null"}]}
      },
      "required": ["sampleSequence", "logicalFrame", "stepCounter", "ram", "ramBlocks", "metadata"],
      "type": "object"
    }
  },
  "$id": "wof-training-farm-collector-export-artifact-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actionResultTrajectory": {"anyOf": [{"type": "array"}, {"type": "null"}]},
    "active": {"type": "boolean"},
    "branchId": {"anyOf": [{"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "type": "string"}, {"type": "null"}]},
    "captureBindingSha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "completeness": {"enum": ["COMPLETE", "PARTIAL"]},
    "currentActionResultMetadata": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "episodeGeneration": {"anyOf": [{"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "type": "string"}, {"type": "null"}]},
    "episodeId": {"anyOf": [{"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "type": "string"}, {"type": "null"}]},
    "evidenceKinds": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "exporterSourceFiles": {
      "additionalProperties": false,
      "properties": {
        "collector_export.py": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "collector_export_artifact.schema.json": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "collector_export_record.schema.json": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["collector_export.py", "collector_export_record.schema.json", "collector_export_artifact.schema.json"],
